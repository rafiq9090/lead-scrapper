# Reference only: Django does not load this file automatically.
# Set these in your shell or deployment environment.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set a long random secret for stable sessions, and always for production.
# DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# DJANGO_DB_PATH=C:/path/to/db.sqlite3
# Optional: owned/authorized Nominatim-compatible endpoint, without /search.
# NOMINATIM_URL=https://your-authorized-endpoint.example

# Parallel workers per batch. Bounded ranges: discovery 1-4, scraping 1-8.
DISCOVERY_WORKERS=2
SCRAPER_WORKERS=4
